{
  "name": "dsh-sub2api-status",
  "version": "1.0.0",
  "description": "在 DSH 输入框底部显示当前模型的 Sub2API 倍率与余额",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./host": "./index.js",
    "./server": "./server.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-model-selection",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-plugins"
      ]
    }
  },
  "files": ["index.js", "host.js", "server.js", "client.js", "src", "scripts", "cordis.patch.yml", "README.md"],
  "scripts": { "build": "node scripts/build-client.mjs" },
  "dependencies": { "@deepseek-ai/schemastery": "3.18.5-alpha.1" },
  "license": "MIT"
}
